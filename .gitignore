# Binaries for programs and plugins
web/static/*
!web/static/.gitkeep
web/localdist/*
!web/localdist/.gitkeep
node_modules/
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
!release/
!release/*.exe
*.test
*.out

# Go workspace file
go.work

# Build artifacts
/bin/
/release/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
# vendor/

# IDE and editor files
.idea/
.vscode/
.qcoder/
*.swp
*.swo
*~
.DS_Store

# Environment files
.env
.env.local

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# OS specific
Thumbs.db

# Debug files
debug
__debug_bin

# Test files
test/manifests/*
!test/manifests/.gitkeep
frontend/public/backGroundMap.zip
*.psd
test/storage/*

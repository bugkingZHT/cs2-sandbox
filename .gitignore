# Binaries for programs and plugins
web/static/*
!web/static/.gitkeep
web/localdist/*
!web/localdist/.gitkeep
node_modules/
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
!release/
!release/*.exe
*.test
*.out

# Go workspace file
go.work

# Build artifacts
/bin/
/release/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
# vendor/

# IDE and editor files
.idea/
.vscode/
.qcoder/
*.swp
*.swo
*~
.DS_Store

# Environment files
.env
.env.local
.env.*
!.env.example
!.env.sample
!.env.*.example
.secrets/

# Local browser sessions can contain cookies and authentication tokens
.auth/
*.har
frontend/playwright-report/
frontend/test-results/

# Private Demo recordings and offline Source 2 conversion inputs/intermediates.
# Reduced runtime geometry in frontend/public/map/3d/*.json stays versioned.
*.dem
*.dem.gz
*.dem.bz2
*.vpk
*.nav
*.glb
*.gltf

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# OS specific
Thumbs.db

# Debug files
debug
__debug_bin

# Test files
test/manifests/*
!test/manifests/.gitkeep
frontend/public/backGroundMap.zip
*.psd
test/storage/*
